rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // O Mestre é quem tem um documento em /admins/{uid} (criado à mão no console).
    function mestre() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    match /fichas/{id} {
      // cada jogador só enxerga e edita as próprias fichas; o Mestre vê e edita todas
      allow read: if logado() && (resource.data.ownerUid == request.auth.uid || mestre());
      allow create: if logado() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if logado()
                    && (resource.data.ownerUid == request.auth.uid || mestre())
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if logado() && (resource.data.ownerUid == request.auth.uid || mestre());
    }
  }
}
